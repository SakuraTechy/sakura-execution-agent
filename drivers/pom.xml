<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>top.continew.sakura</groupId>
    <artifactId>sakura-execution-agent-drivers</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Sakura Execution Agent JDBC Drivers</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <driver.profile>undefined</driver.profile>
        <!-- 版本基线参考 continew-common；正式发布可通过 -Dxxx.version 覆盖。 -->
        <mysql.version>8.0.30</mysql.version>
        <oracle.version>12.1.0.2</oracle.version>
        <sqlserver.version>10.2.0.jre8</sqlserver.version>
        <postgresql.version>42.7.2</postgresql.version>
        <sybase.version>16.0</sybase.version>
        <hive.version>3.1.3</hive.version>
        <teradata.version>20.00.00.39</teradata.version>
        <mariadb.version>3.0.5</mariadb.version>
        <kingbase.version>8.6.1</kingbase.version>
        <iris.version>3.10.3</iris.version>
        <informix.version>4.50.11</informix.version>
        <db2.version>12.1.0.0</db2.version>
        <cache.version>16.0</cache.version>
        <gbase8a.version>8.3.81.53</gbase8a.version>
        <gbase8s.version>3.6.3.2</gbase8s.version>
        <tdengine.version>3.5.3</tdengine.version>
        <phoenix.version>5.1.3</phoenix.version>
        <zookeeper.version>3.8.4</zookeeper.version>
        <dm.version>8.1.2.141</dm.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-profile-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.basedir}/${driver.profile}</outputDirectory>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- 每次只启用一个 profile，避免 driver.profile 被多个 profile 相互覆盖。 -->
    <profiles>
        <profile>
            <id>mysql</id>
            <properties><driver.profile>mysql</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>mysql</groupId>
                    <artifactId>mysql-connector-java</artifactId>
                    <version>${mysql.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>com.google.protobuf</groupId>
                            <artifactId>protobuf-java</artifactId>
                        </exclusion>
                    </exclusions>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>oracle</id>
            <properties><driver.profile>oracle</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>com.github.noraui</groupId>
                    <artifactId>ojdbc7</artifactId>
                    <version>${oracle.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>sqlserver</id>
            <properties><driver.profile>sqlserver</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>com.microsoft.sqlserver</groupId>
                    <artifactId>mssql-jdbc</artifactId>
                    <version>${sqlserver.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>postgresql</id>
            <properties><driver.profile>postgresql</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <version>${postgresql.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>greenplum</id>
            <properties><driver.profile>greenplum</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <version>${postgresql.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>gaussdb</id>
            <properties><driver.profile>gaussdb</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <version>${postgresql.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>sybase</id>
            <properties><driver.profile>sybase</driver.profile></properties>
            <dependencies>
                <!-- 专有驱动必须先上传企业 Maven 仓库，禁止使用 systemPath。 -->
                <dependency>
                    <groupId>com.sybase</groupId>
                    <artifactId>jconnect</artifactId>
                    <version>${sybase.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>hive</id>
            <properties><driver.profile>hive</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>org.apache.hive</groupId>
                    <artifactId>hive-jdbc</artifactId>
                    <version>${hive.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>tidb</id>
            <properties><driver.profile>tidb</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>mysql</groupId>
                    <artifactId>mysql-connector-java</artifactId>
                    <version>${mysql.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>oceanbase</id>
            <properties><driver.profile>oceanbase</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>mysql</groupId>
                    <artifactId>mysql-connector-java</artifactId>
                    <version>${mysql.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>teradata</id>
            <properties><driver.profile>teradata</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>com.teradata.jdbc</groupId>
                    <artifactId>terajdbc</artifactId>
                    <version>${teradata.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mariadb</id>
            <properties><driver.profile>mariadb</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>org.mariadb.jdbc</groupId>
                    <artifactId>mariadb-java-client</artifactId>
                    <version>${mariadb.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>kingbase</id>
            <properties><driver.profile>kingbase</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>cn.com.kingbase</groupId>
                    <artifactId>kingbase8</artifactId>
                    <version>${kingbase.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>iris</id>
            <properties><driver.profile>iris</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>com.intersystems</groupId>
                    <artifactId>intersystems-jdbc</artifactId>
                    <version>${iris.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>informix</id>
            <properties><driver.profile>informix</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>com.hcl.informix</groupId>
                    <artifactId>jdbc</artifactId>
                    <version>${informix.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>db2</id>
            <properties><driver.profile>db2</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>com.ibm.db2</groupId>
                    <artifactId>jcc</artifactId>
                    <version>${db2.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>cache</id>
            <properties><driver.profile>cache</driver.profile></properties>
            <dependencies>
                <!-- 专有驱动必须先上传企业 Maven 仓库，禁止使用 systemPath。 -->
                <dependency>
                    <groupId>com.intersys</groupId>
                    <artifactId>cachedb</artifactId>
                    <version>${cache.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>gbase8a</id>
            <properties><driver.profile>gbase8a</driver.profile></properties>
            <dependencies>
                <!-- 专有驱动必须先上传企业 Maven 仓库，禁止使用 systemPath。 -->
                <dependency>
                    <groupId>com.gbase</groupId>
                    <artifactId>jdbc</artifactId>
                    <version>${gbase8a.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>gbase8s</id>
            <properties><driver.profile>gbase8s</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>com.gbasedbt</groupId>
                    <artifactId>jdbc</artifactId>
                    <version>${gbase8s.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>tdengine</id>
            <properties><driver.profile>tdengine</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>com.taosdata.jdbc</groupId>
                    <artifactId>taos-jdbcdriver</artifactId>
                    <version>${tdengine.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>phoenix</id>
            <properties><driver.profile>phoenix</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>org.apache.phoenix</groupId>
                    <artifactId>phoenix-core</artifactId>
                    <version>${phoenix.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.phoenix</groupId>
                    <artifactId>phoenix-hbase-compat-2.4.0</artifactId>
                    <version>${phoenix.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.zookeeper</groupId>
                    <artifactId>zookeeper</artifactId>
                    <version>${zookeeper.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>dm</id>
            <properties><driver.profile>dm</driver.profile></properties>
            <dependencies>
                <dependency>
                    <groupId>com.dameng</groupId>
                    <artifactId>DmJdbcDriver18</artifactId>
                    <version>${dm.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
